#!/usr/bin/env bash
# mcodex — launch mcode with the quota/token status rows.
#
# TWO ERA-SPECIFIC STRATEGIES, chosen by the installed mcode version:
#
#   mcode >= 0.4.0  — NATIVE. mcode grew a `custom-command` status-line item
#                     that runs a command on startup / session change / an
#                     interval and renders its stdout underneath the built-in
#                     status row (see config/0.4.0/tui.statusline.yaml). We
#                     write that config once and exec the stock mcode. No fork,
#                     no patching, nothing modified.
#
#   mcode <  0.4.0  — LEGACY FORK. No such extension point exists there, so we
#                     build a private pristine-tarball fork and inject a
#                     render() override through patches/_loader.mjs. mcode's
#                     own installation is still never touched.
#
# Both paths drive the same renderer (lib/render.mjs), and tests/parity.mjs
# asserts their output is byte-identical.
#
# Usage:
#   mcodex [mcode args...]     ensure the status rows are installed, then launch
#   mcodex install             install/refresh the config only, do not launch
#   mcodex uninstall           remove the config entries
#   mcodex status              report which strategy applies and whether it is set up
#   mcodex doctor              run the self-check
#
# Env overrides:
#   MCODE_QUOTA_FORK_DIR     fork + tarball cache root (legacy path only)
#   MCODE_CODE_ROOT          where mcode is installed (default ~/.minimax-code)
#   MCODE_QUOTA_DEBUG=1      show diagnostics on stderr
#   MCODE_QUOTA_OFFLINE=1    legacy path: never hit the network

set -euo pipefail

# Resolve the real path of this script, following symlinks. mcodex is often
# installed as `ln -s <repo>/mcodex ~/.minimax/bin/mcodex`, and
# BASH_SOURCE[0] returns the symlink path, not the project root. Without
# resolving, every relative path below (lib/, patches/, mcodex-status) would
# be wrong.
SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$SOURCE" ]]; do
  TARGET="$(readlink "$SOURCE")"
  if [[ "$TARGET" = /* ]]; then
    SOURCE="$TARGET"
  else
    SOURCE="$(dirname "$SOURCE")/$TARGET"
  fi
done
QUOTA_DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
CODE_ROOT="${MCODE_CODE_ROOT:-${HOME}/.minimax-code}"
FORK_BASE="${MCODE_QUOTA_FORK_DIR:-${HOME}/.local/share/mcode-quota/mcode-clone}"
CONFIG_YAML="${MCODE_CONFIG_YAML:-${HOME}/.minimax/config.yaml}"
STATUS_BIN="${QUOTA_DIR}/mcodex-status"

NODE_BIN="$(command -v node || true)"
if [[ -z "$NODE_BIN" ]]; then
  echo "mcodex: node not found on PATH" >&2
  exit 1
fi

CURRENT_VERSION="$(cat "${CODE_ROOT}/current" 2>/dev/null | tr -d '[:space:]' || true)"
if [[ -z "$CURRENT_VERSION" ]]; then
  echo "mcodex: cannot determine mcode version (${CODE_ROOT}/current)" >&2
  exit 1
fi

# Portable dotted-numeric version sort. `sort -V` is GNU-only and macOS BSD
# sort only supports it from macOS 15 (Sequoia); this awk form works everywhere.
vsort() {
  awk -F. '{ printf "%09d %09d %09d %s\n", $1+0, $2+0, $3+0, $0 }' \
    | sort \
    | awk '{ print $4 }'
}

# 0.4.0 is the first version with the native custom-command status item.
NATIVE_MIN="0.4.0"
IS_NATIVE=0
if [[ "$(printf '%s\n%s\n' "$NATIVE_MIN" "$CURRENT_VERSION" | vsort | head -n1)" == "$NATIVE_MIN" ]]; then
  IS_NATIVE=1
fi

SRC_RELEASE_DIR="${CODE_ROOT}/releases/${CURRENT_VERSION}"
SRC_LAUNCHER_FILE="${SRC_RELEASE_DIR}/bin/mcode"
# Fall back to whatever the user's PATH resolves to if the release layout moved.
if [[ ! -x "$SRC_LAUNCHER_FILE" ]]; then
  SRC_LAUNCHER_FILE="$(command -v mcode || true)"
fi

# ---------------------------------------------------------------------------
# native path (mcode >= 0.4.0)
# ---------------------------------------------------------------------------
native_apply() {
  local mode="${1:-apply}"
  local out
  if [[ "$mode" == "remove" ]]; then
    out="$("$NODE_BIN" --input-type=module -e "
      import { removeStatuslineConfig } from '${QUOTA_DIR}/lib/config-apply.mjs';
      const r = removeStatuslineConfig('${CONFIG_YAML}');
      console.log(JSON.stringify(r));
    " 2>&1)" || { echo "mcodex: config edit failed: $out" >&2; return 1; }
  else
    out="$("$NODE_BIN" --input-type=module -e "
      import { applyStatuslineConfig } from '${QUOTA_DIR}/lib/config-apply.mjs';
      const r = applyStatuslineConfig('${CONFIG_YAML}', {
        command: '${STATUS_BIN}',
        maxLines: 3,
        intervalSeconds: 10,
        timeoutMs: 5000,
        position: 'below',
        colorMode: 'ansi',
      });
      console.log(JSON.stringify(r));
    " 2>&1)" || { echo "mcodex: config edit failed: $out" >&2; return 1; }
  fi

  local changed
  changed="$("$NODE_BIN" -e "process.stdout.write(String(JSON.parse(process.argv[1]).changed))" "$out" 2>/dev/null || echo "?")"
  if [[ "$changed" == "true" ]]; then
    echo "mcodex: config updated (${CONFIG_YAML})"
  fi
  if [[ "${MCODE_QUOTA_DEBUG:-0}" == "1" ]]; then
    echo "mcodex: config apply -> $out" >&2
  fi
  return 0
}

native_status() {
  local applied="no"
  if [[ -f "$CONFIG_YAML" ]] && grep -q "customStatusLine:" "$CONFIG_YAML" 2>/dev/null \
     && grep -q "custom-command" "$CONFIG_YAML" 2>/dev/null; then
    applied="yes"
  fi
  echo "mcodex status"
  echo "  mcode version   : ${CURRENT_VERSION}"
  echo "  strategy        : native custom-command (no fork, no patching)"
  echo "  config          : ${CONFIG_YAML}"
  echo "  config applied  : ${applied}"
  echo "  status command  : ${STATUS_BIN}"
  echo "  note            : plain 'mcode' shows the rows too — mcodex is not required at runtime"
}

# ---------------------------------------------------------------------------
# legacy path (mcode < 0.4.0)
# ---------------------------------------------------------------------------
legacy_launch() {
  local SIDECAR="${QUOTA_DIR}/sidecar/mcode-quota-fetcher-9f8a7b.mjs"
  local PATCH_ARGS=(--src="$SRC_RELEASE_DIR" --fork-base="$FORK_BASE"
                    --sidecar="$SIDECAR" --current="$CURRENT_VERSION")
  if [[ "${MCODE_QUOTA_OFFLINE:-0}" == "1" ]]; then
    PATCH_ARGS+=(--offline)
  fi

  local PATCH_ERR=""
  if ! PATCH_ERR="$("$NODE_BIN" "$QUOTA_DIR/patches/_loader.mjs" "${PATCH_ARGS[@]}" 2>&1 1>/dev/null)"; then
    echo "mcodex: quota patcher failed — launching plain mcode" >&2
    echo "$PATCH_ERR" >&2
    exec "$SRC_LAUNCHER_FILE" "$@"
  fi
  if [[ "${MCODE_QUOTA_DEBUG:-0}" == "1" && -n "$PATCH_ERR" ]]; then
    echo "$PATCH_ERR" >&2
  fi

  local CLI_JS="${FORK_BASE}/${CURRENT_VERSION}/code/cli.js"
  if [[ ! -f "$CLI_JS" ]]; then
    echo "mcodex: fork CLI not found: $CLI_JS — launching plain mcode" >&2
    exec "$SRC_LAUNCHER_FILE" "$@"
  fi
  exec "$NODE_BIN" "$CLI_JS" "$@"
}

legacy_status() {
  echo "mcodex status"
  echo "  mcode version   : ${CURRENT_VERSION}"
  echo "  strategy        : legacy fork patch (< ${NATIVE_MIN} has no custom-command)"
  echo "  fork base       : ${FORK_BASE}"
  echo "  sidecar         : ${QUOTA_DIR}/sidecar/mcode-quota-fetcher-9f8a7b.mjs"
  if [[ -f "${FORK_BASE}/${CURRENT_VERSION}/code/cli.js" ]]; then
    echo "  fork built      : yes"
  else
    echo "  fork built      : no (will be built on first launch)"
  fi
}

# ---------------------------------------------------------------------------
# dispatch
# ---------------------------------------------------------------------------
if [[ "$IS_NATIVE" == "1" ]]; then
  case "${1:-}" in
    install)
      native_apply apply
      native_status
      exit 0
      ;;
    uninstall)
      native_apply remove
      echo "mcodex: status rows removed from ${CONFIG_YAML}"
      exit 0
      ;;
    status)
      native_status
      exit 0
      ;;
    doctor)
      exec "${QUOTA_DIR}/mcode-quota-doctor" "${@:2}"
      ;;
  esac

  # Ensure the config is in place before launching. Cheap (one file read) and
  # self-healing if mcode rewrites config.yaml.
  native_apply apply || true

  if [[ ! -x "$STATUS_BIN" ]]; then
    echo "mcodex: WARNING ${STATUS_BIN} is not executable; the status block will be empty" >&2
  fi

  if [[ -z "$SRC_LAUNCHER_FILE" ]]; then
    echo "mcodex: cannot find the mcode launcher for ${CURRENT_VERSION}" >&2
    exit 1
  fi
  exec "$SRC_LAUNCHER_FILE" "$@"
fi

case "${1:-}" in
  install)
    echo "mcodex: mcode ${CURRENT_VERSION} predates the native custom-command item;"
    echo "        nothing to install — the fork patch is applied on launch."
    exit 0
    ;;
  uninstall)
    echo "mcodex: nothing to uninstall on the legacy path (the fork is separate from mcode)."
    exit 0
    ;;
  status)
    legacy_status
    exit 0
    ;;
  doctor)
    exec "${QUOTA_DIR}/mcode-quota-doctor" "${@:2}"
    ;;
esac

legacy_launch "$@"
