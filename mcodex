#!/usr/bin/env bash
# mcodex — launch mcode with the quota status line, in a fully isolated fork.
#
# DESIGN (why this is safe):
#   * mcode's own installation is NEVER modified. We patch a private fork
#     built from a pristine npm tarball of the exact installed version.
#   * The sidecar is imported by the fork's cli.js (a static import), NOT via
#     NODE_OPTIONS. NODE_OPTIONS would leak into every child process mcode
#     spawns and was the root cause of the earlier process storm.
#   * The sidecar does not auto-start; its pollers start on the first status
#     line render, i.e. only in the real TUI process.
#   * The patcher is dispatched through patches/_loader.mjs, which picks
#     patches/<version>/mcode-patch-quota.mjs based on the installed mcode
#     version. If the exact version is not present, the loader falls back
#     to the closest patches/<v>/ with v <= current (see DECISIONS D27).
#
# Usage:
#   mcodex [mcode args...]
#
# Env overrides:
#   MCODE_QUOTA_FORK_DIR   fork + tarball cache root (default ~/.local/share/mcode-quota/mcode-clone)
#   MCODE_CODE_ROOT        where mcode is installed (default ~/.minimax-code)
#   MCODE_QUOTA_DEBUG=1    show patcher diagnostics on stderr
#   MCODE_QUOTA_OFFLINE=1  never hit the network (use cached tarball / installed src)

set -euo pipefail

# Resolve the real path of this script, following symlinks. mcodex is often
# installed as `ln -s <repo>/mcodex ~/.minimax/bin/mcodex`, and
# BASH_SOURCE[0] returns the symlink path, not the project root. Without
# resolving, every relative path below (patches/, sidecar/) would be wrong
# and the patcher would fail to find its loader.
SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$SOURCE" ]]; do
  TARGET="$(readlink "$SOURCE")"
  if [[ "$TARGET" = /* ]]; then
    SOURCE="$TARGET"
  else
    SOURCE="$(dirname "$SOURCE")/$TARGET"
  fi
done
QUOTA_DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
CODE_ROOT="${MCODE_CODE_ROOT:-${HOME}/.minimax-code}"
FORK_BASE="${MCODE_QUOTA_FORK_DIR:-${HOME}/.local/share/mcode-quota/mcode-clone}"

CURRENT_POINTER="${CODE_ROOT}/current"
if [[ ! -f "$CURRENT_POINTER" ]]; then
  echo "mcodex: mcode current pointer not found: $CURRENT_POINTER" >&2
  exit 1
fi
CURRENT_VERSION="$(tr -d '\r\n' < "$CURRENT_POINTER")"
SRC_RELEASE_DIR="${CODE_ROOT}/releases/${CURRENT_VERSION}"
SRC_LAUNCHER_FILE="${SRC_RELEASE_DIR}/.mcode-launcher"

if [[ ! -d "$SRC_RELEASE_DIR" ]]; then
  echo "mcodex: mcode release not found: $SRC_RELEASE_DIR" >&2
  exit 1
fi
if [[ ! -x "$SRC_LAUNCHER_FILE" ]]; then
  echo "mcodex: mcode launcher not found: $SRC_LAUNCHER_FILE" >&2
  exit 1
fi

# Use the exact node binary mcode pins, so the fork runs on the same runtime.
NODE_BIN="$(sed -n "s/^exec '\([^']*\)'.*/\1/p" "$SRC_LAUNCHER_FILE" | head -1)"
if [[ -z "${NODE_BIN}" || ! -x "${NODE_BIN}" ]]; then
  NODE_BIN="node"
fi

SIDECAR="${QUOTA_DIR}/sidecar/mcode-quota-fetcher-9f8a7b.mjs"

PATCH_ARGS=(--src="$SRC_RELEASE_DIR" --fork-base="$FORK_BASE"
            --sidecar="$SIDECAR" --current="$CURRENT_VERSION")
if [[ "${MCODE_QUOTA_OFFLINE:-0}" == "1" ]]; then
  PATCH_ARGS+=(--offline)
fi

PATCH_ERR=""
# Dispatch through patches/_loader.mjs — it picks patches/<version>/ based
# on --current, falling back to the closest available <= requested.
if ! PATCH_ERR="$("$NODE_BIN" "$QUOTA_DIR/patches/_loader.mjs" "${PATCH_ARGS[@]}" 2>&1 1>/dev/null)"; then
  echo "mcodex: quota patcher failed — launching plain mcode" >&2
  echo "$PATCH_ERR" >&2
  exec "$SRC_LAUNCHER_FILE" "$@"
fi
if [[ "${MCODE_QUOTA_DEBUG:-0}" == "1" && -n "$PATCH_ERR" ]]; then
  echo "$PATCH_ERR" >&2
fi

CLI_JS="${FORK_BASE}/${CURRENT_VERSION}/code/cli.js"
if [[ ! -f "$CLI_JS" ]]; then
  echo "mcodex: fork CLI not found: $CLI_JS — launching plain mcode" >&2
  exec "$SRC_LAUNCHER_FILE" "$@"
fi

exec "$NODE_BIN" "$CLI_JS" "$@"
