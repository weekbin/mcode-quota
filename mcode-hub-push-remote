#!/usr/bin/env bash
# mcode-hub-push-remote — push local mcode-hub history to the GitHub backup.
#
# Two layouts supported:
#   1. project IS the git root (no parent monorepo) — push current branch
#      directly to the remote, after merging any remote-ahead commits.
#   2. project lives inside a parent monorepo (parent contains .git) —
#      subtree-split the project out of the parent, then push the
#      standalone history to the remote.
#
# Usage:
#   mcode-hub-push-remote [remote-url]
#   default remote-url: https://github.com/weekbin/mcode-hub.git
#
# Safe to re-run: it never force-pushes over remote work; uses `-s ours`
# merge to record remote tip as a second parent if the remote moved
# ahead.

set -euo pipefail

QUOTA_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PARENT_REPO="$(cd "${QUOTA_DIR}/.." && pwd)"
SUBPATH="$(basename "${QUOTA_DIR}")"
REMOTE_URL="${1:-https://github.com/weekbin/mcode-hub.git}"
MIRROR="$(mktemp -d -t mcode-hub-push-mirror.XXXXXX)"
trap 'rm -rf "${MIRROR}"' EXIT

if [[ -d "${PARENT_REPO}/.git" && "${PARENT_REPO}" != "${QUOTA_DIR}" ]]; then
  # Layout 2: project is a subdir of a parent monorepo. subtree-split
  # this dir out into a standalone branch.
  LAYOUT="monorepo"
elif [[ -d "${QUOTA_DIR}/.git" ]]; then
  # Layout 1: project IS the git root. No split needed.
  LAYOUT="standalone"
else
  echo "mcode-hub-push-remote: no .git found at ${QUOTA_DIR} or ${PARENT_REPO}" >&2
  exit 1
fi

if [[ "${LAYOUT}" == "monorepo" ]]; then
  echo "[1/3] splitting ${SUBPATH}/ history out of ${PARENT_REPO} ..."
  (
    cd "${PARENT_REPO}"
    git subtree split --prefix="${SUBPATH}" -b mcode-hub-standalone
  )

  echo "[2/3] staging into temp mirror at ${MIRROR} ..."
  (
    cd "${PARENT_REPO}"
    git init -q -b master "${MIRROR}"
    cd "${MIRROR}"
    git fetch -q "${PARENT_REPO}" mcode-hub-standalone:fetched
    # The fetched branch is the standalone history; check it out as master.
    git checkout -q -b master fetched
    git branch -q -D fetched 2>/dev/null || true
  )
  cd "${MIRROR}"
else
  echo "[standalone] project IS git root (${QUOTA_DIR}); pushing ${SUBPATH} branch directly"
  cd "${MIRROR}"
  git init -q -b master "${MIRROR}"
  git fetch -q "${QUOTA_DIR}" master:fetched
  git checkout -q -b master fetched
  git branch -q -D fetched 2>/dev/null || true
  cd "${MIRROR}"
fi

echo "[3/3] pushing to ${REMOTE_URL} ..."
(
  cd "${MIRROR}"
  git remote add origin "${REMOTE_URL}"

  # The remote may have moved ahead of us — e.g. another machine pushed work
  # while this tree was being edited. A plain push then fails as
  # non-fast-forward, and force-pushing would destroy those commits.
  #
  # Instead: fetch the remote and MERGE it with `-s ours`. That records the
  # remote tip as a second parent (so the push fast-forwards and nothing is
  # lost from the graph) while keeping THIS tree as the result — which is
  # correct because any remote changes have already been reconciled into the
  # working tree by hand before running this script.
  if git fetch -q origin master 2>/dev/null; then
    if git merge-base --is-ancestor origin/master HEAD 2>/dev/null; then
      echo "  remote is behind us; fast-forward push"
    else
      BEHIND="$(git rev-list --count HEAD..origin/master 2>/dev/null || echo '?')"
      echo "  remote is ahead by ${BEHIND} commit(s); merging with -s ours"
      echo "  (their graph is preserved; their content must already be in this tree)"
      git merge -q --no-edit -s ours origin/master
    fi
  fi

  git -c credential.helper='!gh auth git-credential' push -u origin master
)

echo "done: ${REMOTE_URL}"
