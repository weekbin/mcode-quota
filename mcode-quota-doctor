#!/usr/bin/env bash
# mcodex doctor — verify the fork-isolated quota status line.
#
# Exit 0 = all good; non-zero = something needs attention.
#
# Key invariant this script exists to protect:
#   mcode's own installation must be BYTE-IDENTICAL to the npm release.
#   All patching happens in a private fork, never in mcode.
set -uo pipefail

QUOTA_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CODE_ROOT="${MCODE_CODE_ROOT:-$HOME/.minimax-code}"
FORK_BASE="${MCODE_QUOTA_FORK_DIR:-$HOME/.local/share/mcode-quota/mcode-clone}"
SIDECAR="$QUOTA_DIR/sidecar/mcode-quota-fetcher-9f8a7b.mjs"

PASS=0
FAIL=0
WARN=0
say()  { printf "%-7s %s\n" "$1" "$2"; }
ok()   { say "[ok]"   "$1"; PASS=$((PASS+1)); }
fail() { say "[FAIL]" "$1"; FAIL=$((FAIL+1)); }
warn() { say "[warn]" "$1"; WARN=$((WARN+1)); }
info() { say "[info]" "$1"; }

# 1. mcode installed
CURRENT_FILE="$CODE_ROOT/current"
if [[ -f "$CURRENT_FILE" ]]; then
  CURRENT_VERSION="$(tr -d '\r\n' < "$CURRENT_FILE")"
  ok "mcode current: $CURRENT_VERSION"
else
  fail "mcode current pointer missing: $CURRENT_FILE"
  echo; echo "  Fix: install mcode first, or set MCODE_CODE_ROOT."; exit 2
fi

SRC_CODE="$CODE_ROOT/releases/$CURRENT_VERSION/lib/node_modules/@minimax-ai/code"
SRC_LAUNCHER="$(ls "$SRC_CODE"/chunks/launcher-*.js 2>/dev/null | head -1 || true)"
FORK_CODE="$FORK_BASE/$CURRENT_VERSION/code"
FORK_LAUNCHER="$(ls "$FORK_CODE"/chunks/launcher-*.js 2>/dev/null | head -1 || true)"

# 2. mcode itself must be pristine
if [[ -n "$SRC_LAUNCHER" && -f "$SRC_LAUNCHER" ]]; then
  if grep -q "__mcodeQuota\|__mcodeRuntime" "$SRC_LAUNCHER"; then
    fail "mcode launcher is PATCHED — mcode must stay pristine! Run: git checkout / reinstall mcode"
  else
    ok "mcode launcher pristine (no quota hooks)"
  fi
  PRISTINE_DIR="$FORK_BASE/.pristine-$CURRENT_VERSION"
  if [[ -f "$PRISTINE_DIR/chunks/$(basename "$SRC_LAUNCHER")" ]]; then
    if cmp -s "$SRC_LAUNCHER" "$PRISTINE_DIR/chunks/$(basename "$SRC_LAUNCHER")"; then
      ok "mcode launcher byte-identical to pristine npm tarball"
    else
      fail "mcode launcher differs from pristine npm tarball"
    fi
  else
    info "no pristine reference cached; skipped byte-compare"
  fi
else
  fail "mcode launcher not found in $SRC_CODE/chunks"
fi

# 3. fork exists and matches the installed version
if [[ -f "$FORK_BASE/$CURRENT_VERSION/.fork-marker" ]]; then
  ok "fork marker: $FORK_BASE/$CURRENT_VERSION"
else
  warn "fork not initialized yet — run: mcodex (it builds the fork on first launch)"
fi

# 4. fork launcher patched
if [[ -n "$FORK_LAUNCHER" && -f "$FORK_LAUNCHER" ]]; then
  if grep -q "__mcodeQuotaRender" "$FORK_LAUNCHER"; then
    ok "fork launcher render hook present"
  else
    fail "fork launcher render hook missing — re-run: mcodex"
  fi
else
  warn "fork launcher not built yet"
fi

# 5. fork cli.js imports the sidecar (no NODE_OPTIONS)
if [[ -f "$FORK_CODE/cli.js" ]]; then
  if grep -q "mcode-quota-sidecar" "$FORK_CODE/cli.js"; then
    ok "fork cli.js imports sidecar statically"
  else
    fail "fork cli.js does not import the sidecar — re-run: mcodex"
  fi
else
  warn "fork cli.js not built yet"
fi

# 6. sidecar present + syntax valid
if [[ -f "$SIDECAR" ]]; then
  if node --check "$SIDECAR" >/dev/null 2>&1; then
    ok "sidecar present + syntax ok: $SIDECAR"
  else
    fail "sidecar failed node --check: $SIDECAR"
  fi
else
  fail "sidecar missing: $SIDECAR — run: mcodex"
fi

# 7. no NODE_OPTIONS leakage (the old storm root cause)
if grep -qE '^[[:space:]]*(export[[:space:]]+)?NODE_OPTIONS=' "$QUOTA_DIR/mcodex"; then
  fail "mcodex sets NODE_OPTIONS — this leaks the sidecar into child processes (storm risk)"
else
  ok "mcodex does not use NODE_OPTIONS"
fi

# 8. live render test (no mcode needed)
if [[ -f "$SIDECAR" ]]; then
  LIVE="$(
    SIDECAR="$SIDECAR" node --input-type=module -e '
      const sid = process.env.MCODE_QUOTA_TEST_SESSION || await (async () => {
        try {
          const { DatabaseSync } = await import("node:sqlite");
          const db = new DatabaseSync(process.env.HOME + "/.minimax/v2/sqlite/runtime-state.sqlite", { readOnly: true });
          const row = db.prepare("SELECT session_id FROM local_runtime_token_usage ORDER BY ts DESC LIMIT 1").get();
          return row ? row.session_id : "";
        } catch { return ""; }
      })();
      await import(process.env.SIDECAR);
      globalThis.__mcodeShellState = {
        agentSessionId: sid,
        contextUsage: { usedTokens: 42000, contextWindowTokens: 200000 },
      };
      globalThis.__mcodeQuotaRender(200);
      await new Promise((r) => setTimeout(r, 6000));
      // Wide: the breakdown should be there. Narrow: it should be gone to save
      // room, while 上下文 survives. "@@@" separates the two captures.
      process.stdout.write(
        globalThis.__mcodeQuotaRender(200).join("\n") +
        "\n@@@\n" +
        globalThis.__mcodeQuotaRender(100).join("\n")
      );
    ' 2>/dev/null || echo "(live test failed)"
  )"
  CLEAN="$(printf '%s' "$LIVE" | sed -E 's/\x1b\[[0-9;]*[A-Za-z]//g')"
  WIDE="${CLEAN%%@@@*}"
  NARROW="${CLEAN##*@@@}"
  if printf '%s' "$WIDE" | grep -q "小时会话窗口" && printf '%s' "$WIDE" | grep -q "周限制使用量"; then
    ok "live render: $(printf '%s' "$WIDE" | head -1 | cut -c1-100)"
  else
    warn "live render produced no quota line (mmx may be down). Raw: $(printf '%s' "$CLEAN" | head -c120)"
  fi
  if printf '%s' "$WIDE" | grep -q "会话 tokens"; then
    ok "session tokens line: $(printf '%s' "$WIDE" | grep -o '会话 tokens[^│]*' | head -1 | cut -c1-60)"
  else
    info "session tokens line not present (no session row yet?)"
  fi
  if printf '%s' "$WIDE" | grep -q "输入"; then
    ok "breakdown shown at 200 cols: $(printf '%s' "$WIDE" | grep -o '输入 [^)]*' | head -1 | cut -c1-52)"
  elif [[ "${MCODE_QUOTA_TAIL:-}" == "compact" ]]; then
    info "breakdown omitted (MCODE_QUOTA_TAIL=compact)"
  else
    warn "breakdown missing at 200 cols (expected 输入/输出/缓存)"
  fi
  if printf '%s' "$NARROW" | grep -q "输入"; then
    ok "breakdown kept at 100 cols (>= 80 threshold)"
  elif [[ "${MCODE_QUOTA_TAIL:-}" == "compact" ]]; then
    info "breakdown omitted (MCODE_QUOTA_TAIL=compact)"
  else
    warn "breakdown missing at 100 cols (>= 80 threshold should keep it)"
  fi
  if printf '%s' "$CLEAN" | grep -q "上下文 21% 「42.0K/200.0K」"; then
    ok "context usage: $(printf '%s' "$CLEAN" | grep -o '上下文 \S*21% 「[^」]*」' | head -1)"
  else
    warn "context usage chunk missing (expected 上下文 21% 「42.0K/200.0K」)"
  fi
  if printf '%s' "$CLEAN" | grep -q "缓存命中"; then
    ok "cache hit rate: $(printf '%s' "$CLEAN" | grep -o '缓存命中 [0-9]*%' | head -1)"
  else
    warn "cache hit rate missing (expected 缓存命中 NN%)"
  fi
  if printf '%s' "$CLEAN" | grep -q "轮数 "; then
    ok "turn count: $(printf '%s' "$CLEAN" | grep -o '轮数 [0-9]*' | head -1)"
  else
    warn "turn count missing (expected 轮数 NN)"
  fi
  if printf '%s' "$CLEAN" | grep -q "│"; then
    ok "separator is │ (U+2502)"
  else
    warn "separator is not │"
  fi
  # Section contract (v2.5): the quota block has two rows on the wide layout:
  # 会话 tokens + 上下文 is on TOP (closest to the mcode status bar above it);
  # the token-usage row (小时会话窗口 / 周限制使用量) is BELOW.
  WIDE_LINES="$(printf '%s' "$WIDE" | awk '/会话 tokens/{f=1} f{print; if(/周限制使用量|小时会话窗口/) {found=1; exit}}')"
  if printf '%s' "$WIDE_LINES" | head -1 | grep -q "会话 tokens"; then
    ok "section contract: 会话 tokens row first (closest to mcode status bar)"
  else
    warn "section contract violated: 会话 tokens should be the first line"
  fi
  if printf '%s' "$WIDE_LINES" | grep -q "小时会话窗口\|周限制使用量"; then
    ok "section contract: token-usage row below (小时会话窗口 / 周限制使用量)"
  else
    warn "section contract violated: token-usage row should be below"
  fi
fi

# 9. mmx available + logged in
if command -v mmx >/dev/null 2>&1; then
  ok "mmx on PATH: $(command -v mmx)"
  AUTH="$(mmx auth status --output json 2>/dev/null | head -c 200 || true)"
  if [[ -n "$AUTH" ]] && ! printf '%s' "$AUTH" | grep -qi "not.*sign\|login.*required\|not_logged"; then
    ok "mmx appears logged in"
  else
    warn "mmx may not be logged in — quota line will stay empty"
  fi
else
  warn "mmx not on PATH — quota line will stay empty"
fi

# 10. PATH entrypoint
if [[ -x "$HOME/.minimax/bin/mcodex" ]]; then
  ok "PATH entry: ~/.minimax/bin/mcodex"
else
  warn "PATH entry missing: ~/.minimax/bin/mcodex (launch with $QUOTA_DIR/mcodex)"
fi

# 11. no stale mcodex/mmx processes from a previous storm
STRAY_MMX="$(pgrep -fc 'mmx quota show' 2>/dev/null || true)"
STRAY_MMX="${STRAY_MMX:-0}"
if [[ "$STRAY_MMX" -gt 2 ]]; then
  warn "$STRAY_MMX concurrent 'mmx quota show' processes — possible storm"
else
  ok "no mmx process storm (concurrent: $STRAY_MMX)"
fi

echo
echo "Result: $PASS ok, $WARN warnings, $FAIL failures"
[[ $FAIL -eq 0 ]] && exit 0 || exit 1
