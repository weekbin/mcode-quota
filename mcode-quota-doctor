#!/usr/bin/env bash
# Doctor script: verify that the mcode status-bar quota patch is in place.
# Exit 0 = all good; non-zero = something needs attention.
set -uo pipefail

CODE_ROOT="${MCODE_CODE_ROOT:-$HOME/.minimax-code}"
CURRENT_FILE="$CODE_ROOT/current"

PASS=0
FAIL=0
WARN=0
say() { printf "%-12s %s\n" "$1" "$2"; }
ok()   { say "[ok]"      "$1"; PASS=$((PASS+1)); }
fail() { say "[FAIL]"    "$1"; FAIL=$((FAIL+1)); }
warn() { say "[warn]"    "$1"; WARN=$((WARN+1)); }
info() { say "[info]"    "$1"; }

# 1. mcode installed
if [[ -f "$CURRENT_FILE" ]]; then
  ok "mcode current pointer: $(cat "$CURRENT_FILE")"
else
  fail "mcode current pointer missing: $CURRENT_FILE"
  echo
  echo "  Fix: install mcode first, or set MCODE_CODE_ROOT."
  exit 2
fi
CURRENT_VERSION="$(tr -d '\r\n' < "$CURRENT_FILE")"

# 2. launcher exists
CHUNKS_DIR="$CODE_ROOT/releases/$CURRENT_VERSION/lib/node_modules/@minimax-ai/code/chunks"
LAUNCHER="$(ls "$CHUNKS_DIR"/launcher-*.js 2>/dev/null | head -1 || true)"
if [[ -z "$LAUNCHER" || ! -f "$LAUNCHER" ]]; then
  fail "Launcher not found in $CHUNKS_DIR"
  exit 2
fi
ok "Launcher: $LAUNCHER"

# 3. backup exists
BACKUP="$LAUNCHER.unpatched.bak"
if [[ -f "$BACKUP" ]]; then
  ok "Backup present (restore with: cp '$BACKUP' '$LAUNCHER')"
else
  warn "No backup. Run mcode-patch-quota.sh to create one."
fi

# 4. patch anchors present
if grep -q "__mcodeQuotaLine" "$LAUNCHER"; then
  ok "Render hook (Xc.render) patched"
else
  fail "Render hook missing — run mcode-patch-quota.sh to (re)apply"
fi
if grep -q "__mcodeQuotaStart" "$LAUNCHER"; then
  ok "Widget hook (jf.constructor) patched"
else
  fail "Widget hook missing — run mcode-patch-quota.sh to (re)apply"
fi

# 5. sidecar present
SIDECAR="$CHUNKS_DIR/mcode-quota-fetcher-9f8a7b.mjs"
if [[ -f "$SIDECAR" ]]; then
  ok "Sidecar: $SIDECAR"
else
  fail "Sidecar missing — run mcode-patch-quota.sh"
fi

# 6. mmx available
if command -v mmx >/dev/null 2>&1; then
  ok "mmx on PATH: $(command -v mmx)"
else
  warn "mmx not on PATH — quota line will stay empty"
fi

# 7. sidecar live test (no mcode needed)
if [[ -f "$SIDECAR" ]] && command -v mmx >/dev/null 2>&1; then
  LINE=$(node --input-type=module -e "
    import('$SIDECAR').then(async () => {
      globalThis.__mcodeQuotaStart(() => {});
      await new Promise(r => setTimeout(r, 2500));
      process.stdout.write(globalThis.__mcodeQuotaLine || '(empty)');
    });
  " 2>/dev/null || echo "(test failed)")
  if [[ -n "$LINE" && "$LINE" != "(empty)" && "$LINE" != "(test failed)" ]]; then
    ok "Sidecar live render: $LINE"
  else
    warn "Sidecar returned: $LINE  (check mmx quota show --output json)"
  fi
fi

# 8. wrapper present
WRAPPER="$HOME/.minimax/bin/mcode-with-quota"
if [[ -x "$WRAPPER" ]]; then
  ok "Wrapper: $WRAPPER (launch with: mcode-with-quota)"
else
  warn "Wrapper missing — install it to skip manual NODE_OPTIONS"
fi

# 9. mmx login state (best effort)
if command -v mmx >/dev/null 2>&1; then
  AUTH=$(mmx auth status --output json 2>/dev/null | head -c 200 || true)
  if [[ -n "$AUTH" ]] && ! echo "$AUTH" | grep -qi "not.*sign\|login.*required\|not_logged"; then
    ok "mmx appears logged in"
  else
    warn "mmx may not be logged in — quota line will stay empty"
  fi
fi

echo
echo "Result: $PASS ok, $WARN warnings, $FAIL failures"
[[ $FAIL -eq 0 ]] && exit 0 || exit 1
